# ============================================================
#   WHATSAPP BOT BAILEYS - KONFIGURASI
#   Salin file ini menjadi .env dan isi nilai di bawah
# ============================================================

# -------------------------------------------------------
# OPENAI (otak utama + pembuatan gambar)
# Dapatkan API key di: https://platform.openai.com/api-keys
# -------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Otak kedua yang dipakai saat OpenAI limit/gangguan
GROQ_API_KEY=your_groq_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Provider tambahan (opsional; juga bisa dimasukkan dari panel admin)
GEMINI_API_KEY=your_gemini_api_key_here
SEADREAM_API_KEY=your_seadream_api_key_here
LEONARDO_API_KEY=your_leonardo_api_key_here

# Opsional: rahasia enkripsi tetap. Jika kosong, dibuat otomatis secara lokal.
API_KEY_ENCRYPTION_SECRET=

# -------------------------------------------------------
# INFO BISNIS / BOT
# -------------------------------------------------------
BUSINESS_NAME=Toko Saya
OWNER_NAME=Admin
OWNER_NUMBER=628123456789

# Nomor akun bot untuk pairing code di Termux (tanpa +, spasi, atau strip)
PAIRING_NUMBER=628123456789

# -------------------------------------------------------
# PENGATURAN BOT
# -------------------------------------------------------
# Prefix perintah bot (!, /, ., atau #).
# Jangan gunakan nama PREFIX karena bentrok dengan variabel sistem Termux.
BOT_PREFIX=!

# Aktifkan/nonaktifkan fitur (true/false)
AUTO_READ=true
AUTO_TYPING=true
ANTI_SPAM=true
WELCOME_MESSAGE=true
# Di grup, bot hanya merespons pesan yang diawali BOT_PREFIX (!).

# -------------------------------------------------------
# PANEL ADMIN
# -------------------------------------------------------
# Default hanya dapat diakses dari HP yang menjalankan Termux.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=ganti_dengan_password_yang_kuat

# true = buat URL publik Cloudflare; ADMIN_PASSWORD wajib diisi
ENABLE_TUNNEL=false
